# React Native environment config
# Copy to .env and fill in your backend URLs

# Nex Playground API host
EXPO_PUBLIC_API_BASE_URL=https://your-nex-api.azurewebsites.net

# VR Games + Sessions + Feedback API host
EXPO_PUBLIC_VR_API_BASE_URL=https://dspirezone-app-dev.azurewebsites.net

# VR game installations endpoint host (headset_code/headset_id source)
EXPO_PUBLIC_VR_INSTALLATIONS_API_BASE_URL=https://dspirezone-vr-app.azurewebsites.net

# VR sessions endpoint host (Confirm & Print source)
EXPO_PUBLIC_VR_SESSIONS_API_BASE_URL=https://dspirezone-vr-app.azurewebsites.net
