{
  "expo": {
    "name": "Dspire VR Zone",
    "slug": "dzexpo-proj",
    "version": "1.6.4",
    "jsEngine": "jsc",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D1A"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D1A"
      },
      "package": "com.dspirevr.zone",
      "versionCode": 20,
      "permissions": [
        "INTERNET"
      ],
      "blockedPermissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "apiBaseUrl": "https://www.dspirezone.com",
      "eas": {
        "projectId": "4664e1c9-4756-4409-ad7a-66dad16db318"
      }
    },
    "owner": "dspirezone"
  }
}
